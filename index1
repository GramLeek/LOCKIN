<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#090b09" />

  <title>LOCKIN Community — $LOCKIN on TON</title>
  <meta name="description" content="$LOCKIN on TON. Real app. Real traders. Real degenerates. Community-built around the Lockin trading culture." />

  <meta property="og:title" content="LOCKIN Community — $LOCKIN on TON" />
  <meta property="og:description" content="Real app. Real traders. Real degens." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="assets/hero/hero-character.png" />

  <link rel="icon" type="image/png" href="assets/logo/logo.png" />

  <style>
    :root {
      --bg: #070907;
      --bg-2: #0b0e0b;
      --panel: rgba(18, 22, 18, 0.78);
      --panel-2: rgba(12, 15, 12, 0.92);
      --line: rgba(212, 255, 47, 0.16);
      --line-strong: rgba(212, 255, 47, 0.32);
      --green: #d5ff31;
      --green-2: #a9ff30;
      --text: #f3f5ef;
      --muted: #8f978d;
      --muted-2: #626961;
      --red: #ff6464;
      --shadow: 0 24px 80px rgba(0, 0, 0, 0.42);
      --radius: 22px;
      --max: 1240px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      background: var(--bg);
    }

    body {
      margin: 0;
      color: var(--text);
      background:
        radial-gradient(circle at 82% 13%, rgba(213, 255, 49, 0.10), transparent 28%),
        radial-gradient(circle at 15% 40%, rgba(213, 255, 49, 0.055), transparent 24%),
        linear-gradient(180deg, #080a08 0%, #060806 44%, #090b09 100%);
      font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 100;
      opacity: 0.17;
      background-image:
        radial-gradient(circle, rgba(255,255,255,.28) 0.7px, transparent 0.8px);
      background-size: 5px 5px;
      mix-blend-mode: soft-light;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    .shell {
      width: min(calc(100% - 40px), var(--max));
      margin: 0 auto;
    }

    .mono {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: var(--green);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .16em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 14px rgba(213,255,49,.78);
    }

    .nav-wrap {
      position: relative;
      z-index: 30;
      padding-top: 18px;
    }

    nav {
      min-height: 66px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 9px 12px 9px 16px;
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 18px;
      background: rgba(10, 13, 10, 0.72);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 18px 60px rgba(0,0,0,.24);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: max-content;
    }

    .brand img {
      width: 38px;
      height: 38px;
      object-fit: contain;
      filter: drop-shadow(0 0 12px rgba(213,255,49,.14));
    }

    .brand-copy {
      line-height: .92;
      font-weight: 950;
      letter-spacing: -.04em;
      font-size: 18px;
    }

    .brand-copy small {
      display: block;
      margin-top: 5px;
      color: var(--muted);
      font-size: 9px;
      letter-spacing: .18em;
      font-weight: 700;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .nav-links a {
      padding: 11px 13px;
      color: #b8beb5;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .05em;
      border-radius: 10px;
      transition: .2s ease;
    }

    .nav-links a:hover {
      color: var(--text);
      background: rgba(255,255,255,.045);
    }

    .nav-buy {
      padding: 12px 17px !important;
      color: #0a0c08 !important;
      background: var(--green) !important;
      box-shadow: 0 0 30px rgba(213,255,49,.12);
    }

    .nav-buy:hover {
      transform: translateY(-1px);
      box-shadow: 0 0 34px rgba(213,255,49,.22);
    }

    .hero {
      position: relative;
      z-index: 2;
      min-height: 740px;
      display: grid;
      grid-template-columns: 1.02fr .98fr;
      align-items: center;
      gap: 30px;
      padding: 62px 0 52px;
    }

    .hero::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 6%;
      width: 100vw;
      height: 620px;
      transform: translateX(-50%);
      pointer-events: none;
      z-index: -2;
      background-image:
        linear-gradient(rgba(213,255,49,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(213,255,49,.035) 1px, transparent 1px);
      background-size: 54px 54px;
      mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 70%, transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 70%, transparent 100%);
    }

    .hero-copy {
      position: relative;
      z-index: 4;
      max-width: 670px;
    }

    .hero h1 {
      margin: 20px 0 22px;
      font-size: clamp(62px, 7vw, 108px);
      line-height: .84;
      letter-spacing: -.075em;
      font-weight: 950;
      text-transform: uppercase;
    }

    .hero h1 span {
      display: block;
    }

    .hero h1 .acid {
      color: var(--green);
      text-shadow: 0 0 32px rgba(213,255,49,.09);
    }

    .hero-sub {
      max-width: 580px;
      margin: 0 0 30px;
      color: #a7afa4;
      font-size: clamp(16px, 1.5vw, 19px);
      line-height: 1.55;
      letter-spacing: -.015em;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 22px;
    }

    .btn {
      min-height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 0 20px;
      border: 1px solid rgba(255,255,255,.09);
      border-radius: 13px;
      background: rgba(255,255,255,.035);
      color: var(--text);
      font-size: 13px;
      font-weight: 900;
      letter-spacing: .04em;
      text-transform: uppercase;
      cursor: pointer;
      transition: .2s ease;
    }

    .btn:hover {
      transform: translateY(-2px);
      border-color: rgba(255,255,255,.18);
      background: rgba(255,255,255,.06);
    }

    .btn-primary {
      color: #090b08;
      border-color: var(--green);
      background: var(--green);
      box-shadow: 0 14px 36px rgba(213,255,49,.10);
    }

    .btn-primary:hover {
      background: #e0ff5a;
      border-color: #e0ff5a;
      box-shadow: 0 18px 42px rgba(213,255,49,.16);
    }

    .btn svg {
      width: 16px;
      height: 16px;
    }

    .contract {
      width: min(100%, 625px);
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 12px;
      padding: 10px 10px 10px 14px;
      border: 1px solid rgba(255,255,255,.075);
      border-radius: 14px;
      background: rgba(4,6,4,.48);
      overflow: hidden;
    }

    .contract-label {
      color: var(--muted-2);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: .12em;
    }

    .contract-code {
      color: #c0c7bd;
      font-size: 11px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .copy-btn {
      border: 1px solid rgba(213,255,49,.13);
      border-radius: 9px;
      padding: 9px 11px;
      background: rgba(213,255,49,.06);
      color: var(--green);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: .08em;
      cursor: pointer;
    }

    .hero-art {
      position: relative;
      align-self: stretch;
      min-height: 610px;
      isolation: isolate;
    }

    .hero-art::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: 4%;
      width: 74%;
      height: 15%;
      transform: translateX(-50%);
      z-index: -1;
      background: rgba(213,255,49,.13);
      filter: blur(70px);
      border-radius: 50%;
    }

    .moon {
      position: absolute;
      z-index: 0;
      width: 82%;
      max-width: 650px;
      left: 50%;
      top: 4%;
      transform: translateX(-50%);
      object-fit: contain;
      filter: saturate(.86) brightness(.82) contrast(1.05) drop-shadow(0 0 42px rgba(255,181,45,.08));
      opacity: .88;
      animation: moonFloat 9s ease-in-out infinite;
    }

    .hero-character {
      position: absolute;
      z-index: 2;
      width: 104%;
      max-width: 740px;
      left: 49%;
      bottom: -1%;
      transform: translateX(-50%);
      object-fit: contain;
      filter: drop-shadow(0 26px 30px rgba(0,0,0,.42));
      animation: characterFloat 6.5s ease-in-out infinite;
    }

    .hero-badge {
      position: absolute;
      z-index: 4;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 9px 12px;
      border: 1px solid rgba(213,255,49,.16);
      border-radius: 999px;
      background: rgba(7,9,7,.76);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      color: #d6ddd2;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .08em;
      box-shadow: 0 14px 30px rgba(0,0,0,.22);
    }

    .hero-badge i {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 12px rgba(213,255,49,.8);
    }

    .badge-a {
      top: 21%;
      left: 0;
      transform: rotate(-4deg);
    }

    .badge-b {
      right: 1%;
      bottom: 16%;
      transform: rotate(3deg);
    }

    @keyframes characterFloat {
      0%,100% { transform: translateX(-50%) translateY(0) rotate(-.25deg); }
      50% { transform: translateX(-50%) translateY(-8px) rotate(.25deg); }
    }

    @keyframes moonFloat {
      0%,100% { transform: translateX(-50%) scale(1); }
      50% { transform: translateX(-50%) scale(1.012); }
    }

    .market-wrap {
      position: relative;
      z-index: 8;
      margin-top: -2px;
    }

    .market {
      display: grid;
      grid-template-columns: 1.2fr repeat(5, 1fr);
      border: 1px solid rgba(255,255,255,.075);
      border-radius: var(--radius);
      background: linear-gradient(180deg, rgba(17,21,17,.94), rgba(10,13,10,.94));
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .market-head,
    .metric {
      min-height: 104px;
      padding: 21px 20px;
      border-right: 1px solid rgba(255,255,255,.06);
    }

    .market > :last-child {
      border-right: none;
    }

    .market-head {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .live-state {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--green);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: .12em;
    }

    .live-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 14px rgba(213,255,49,.78);
      animation: pulse 1.8s ease-in-out infinite;
    }

    @keyframes pulse {
      0%,100% { opacity: .45; }
      50% { opacity: 1; }
    }

    .pair-name {
      font-size: 18px;
      font-weight: 950;
      letter-spacing: -.035em;
    }

    .metric-label {
      margin-bottom: 10px;
      color: var(--muted-2);
      font-size: 9px;
      font-weight: 900;
      letter-spacing: .13em;
      text-transform: uppercase;
    }

    .metric-value {
      font-size: clamp(18px, 1.8vw, 25px);
      font-weight: 900;
      letter-spacing: -.045em;
      white-space: nowrap;
    }

    .metric-sub {
      margin-top: 7px;
      color: var(--muted-2);
      font-size: 9px;
    }

    .positive { color: var(--green); }
    .negative { color: var(--red); }

    section {
      position: relative;
      padding: 120px 0;
    }

    .section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 28px;
      margin-bottom: 42px;
    }

    .section-heading h2 {
      max-width: 820px;
      margin: 10px 0 0;
      font-size: clamp(42px, 5vw, 70px);
      line-height: .94;
      letter-spacing: -.06em;
      text-transform: uppercase;
    }

    .section-heading p {
      max-width: 380px;
      margin: 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.55;
    }

    .culture {
      overflow: hidden;
    }

    .culture::before {
      content: "LOCKIN";
      position: absolute;
      right: -1vw;
      top: 70px;
      z-index: -1;
      color: rgba(213,255,49,.025);
      font-size: min(25vw, 330px);
      font-weight: 950;
      letter-spacing: -.09em;
      line-height: .8;
    }

    .sticker-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 12px;
    }

    .sticker {
      position: relative;
      min-width: 0;
      aspect-ratio: 1 / 1;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 20px;
      background:
        radial-gradient(circle at 50% 45%, rgba(213,255,49,.075), transparent 48%),
        rgba(13,16,13,.68);
      overflow: hidden;
      transition: .22s ease;
    }

    .sticker:nth-child(3n+2) {
      transform: translateY(18px);
    }

    .sticker:hover {
      transform: translateY(-5px) scale(1.015);
      border-color: rgba(213,255,49,.22);
      box-shadow: 0 18px 50px rgba(0,0,0,.28);
    }

    .sticker:nth-child(3n+2):hover {
      transform: translateY(13px) scale(1.015);
    }

    .sticker::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(135deg, rgba(255,255,255,.025), transparent 34%);
    }

    .sticker video {
      width: 92%;
      height: 92%;
      object-fit: contain;
      display: block;
    }

    .app-panel {
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      gap: 14px;
    }

    .app-card,
    .terminal-card {
      min-height: 460px;
      border: 1px solid rgba(255,255,255,.075);
      border-radius: 28px;
      overflow: hidden;
      background: rgba(12,15,12,.82);
      box-shadow: var(--shadow);
    }

    .app-card {
      position: relative;
      padding: 38px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background:
        radial-gradient(circle at 76% 26%, rgba(213,255,49,.12), transparent 32%),
        linear-gradient(155deg, rgba(20,25,20,.96), rgba(8,11,8,.98));
    }

    .app-card::before {
      content: "";
      position: absolute;
      right: -100px;
      bottom: -100px;
      width: 360px;
      height: 360px;
      border: 1px solid rgba(213,255,49,.10);
      border-radius: 50%;
      box-shadow:
        0 0 0 42px rgba(213,255,49,.02),
        0 0 0 84px rgba(213,255,49,.015);
    }

    .app-card h3 {
      position: relative;
      z-index: 2;
      max-width: 600px;
      margin: 16px 0 16px;
      font-size: clamp(43px, 5vw, 70px);
      line-height: .92;
      letter-spacing: -.065em;
      text-transform: uppercase;
    }

    .app-card p {
      position: relative;
      z-index: 2;
      max-width: 490px;
      color: #a5ada2;
      font-size: 15px;
      line-height: 1.6;
    }

    .app-actions {
      position: relative;
      z-index: 2;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .terminal-card {
      position: relative;
      padding: 18px;
      background:
        linear-gradient(rgba(213,255,49,.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(213,255,49,.03) 1px, transparent 1px),
        #080b08;
      background-size: 28px 28px;
    }

    .terminal-window {
      height: 100%;
      border: 1px solid rgba(213,255,49,.11);
      border-radius: 18px;
      background: rgba(6,8,6,.87);
      overflow: hidden;
    }

    .terminal-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 48px;
      padding: 0 16px;
      border-bottom: 1px solid rgba(255,255,255,.06);
      color: var(--muted);
      font-size: 10px;
      letter-spacing: .1em;
    }

    .terminal-dots {
      display: flex;
      gap: 6px;
    }

    .terminal-dots i {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: rgba(255,255,255,.13);
    }

    .terminal-body {
      display: flex;
      flex-direction: column;
      gap: 18px;
      padding: 24px;
      font-size: 12px;
      line-height: 1.65;
    }

    .terminal-line {
      display: grid;
      grid-template-columns: 115px 1fr;
      gap: 18px;
      padding-bottom: 16px;
      border-bottom: 1px dashed rgba(255,255,255,.07);
    }

    .terminal-line:last-child {
      border-bottom: none;
    }

    .terminal-key {
      color: var(--green);
      font-weight: 800;
    }

    .terminal-value {
      color: #aeb6ab;
    }

    .terminal-value strong {
      color: var(--text);
    }

    .how-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .how-card {
      position: relative;
      min-height: 280px;
      padding: 28px;
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 22px;
      background: rgba(13,16,13,.7);
      overflow: hidden;
    }

    .how-num {
      color: var(--green);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: .13em;
    }

    .how-card h3 {
      margin: 52px 0 10px;
      font-size: 28px;
      line-height: 1;
      letter-spacing: -.045em;
      text-transform: uppercase;
    }

    .how-card p {
      max-width: 320px;
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.55;
    }

    .how-card::after {
      content: attr(data-mark);
      position: absolute;
      right: -12px;
      bottom: -32px;
      color: rgba(213,255,49,.04);
      font-size: 138px;
      font-weight: 950;
      line-height: 1;
    }

    .final-cta {
      padding-top: 35px;
      padding-bottom: 100px;
    }

    .cta-box {
      position: relative;
      min-height: 370px;
      display: grid;
      place-items: center;
      text-align: center;
      padding: 52px 24px;
      border: 1px solid rgba(213,255,49,.16);
      border-radius: 30px;
      overflow: hidden;
      background:
        radial-gradient(circle at 50% 110%, rgba(213,255,49,.15), transparent 40%),
        linear-gradient(180deg, rgba(18,23,18,.93), rgba(8,11,8,.96));
      box-shadow: var(--shadow);
    }

    .cta-box::before {
      content: "";
      position: absolute;
      inset: 0;
      opacity: .45;
      background:
        radial-gradient(circle at 20% 20%, rgba(213,255,49,.06) 0 1px, transparent 1.5px);
      background-size: 14px 14px;
      mask-image: linear-gradient(90deg, transparent, black 28%, black 72%, transparent);
      -webkit-mask-image: linear-gradient(90deg, transparent, black 28%, black 72%, transparent);
    }

    .cta-content {
      position: relative;
      z-index: 2;
    }

    .cta-box h2 {
      max-width: 850px;
      margin: 14px auto 20px;
      font-size: clamp(54px, 8vw, 105px);
      line-height: .82;
      letter-spacing: -.075em;
      text-transform: uppercase;
    }

    .cta-box h2 span {
      color: var(--green);
    }

    .cta-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 26px;
    }

    footer {
      padding: 26px 0 38px;
      border-top: 1px solid rgba(255,255,255,.055);
    }

    .footer-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .footer-left {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--muted);
      font-size: 11px;
    }

    .footer-left img {
      width: 26px;
      height: 26px;
      object-fit: contain;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: end;
      gap: 16px;
    }

    .footer-links a {
      color: #7f877d;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .footer-links a:hover {
      color: var(--green);
    }

    .disclaimer {
      margin-top: 14px;
      color: #545b52;
      font-size: 9px;
      line-height: 1.5;
      text-align: right;
    }

    .creator-credit {
      margin-top: 12px;
      display: flex;
