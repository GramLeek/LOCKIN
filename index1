        const response = await fetch(DEX_API, { cache: "no-store" });
        if (!response.ok) throw new Error("Market request failed");

        const data = await response.json();
        const pairs = (data.pairs || [])
          .filter(pair => pair.chainId === "ton")
          .sort((a, b) => (Number(b?.liquidity?.usd) || 0) - (Number(a?.liquidity?.usd) || 0));

        const pair = pairs[0];
        if (!pair) throw new Error("No TON pair found");

        els.price.textContent = money(pair.priceUsd, false);

        const cap = Number(pair.marketCap) || Number(pair.fdv);
        els.marketCap.textContent = money(cap);
        els.capType.textContent = pair.marketCap ? "MARKET CAP" : "FDV";

        els.liquidity.textContent = money(pair?.liquidity?.usd);
        els.volume24.textContent = money(pair?.volume?.h24);

        const change = Number(pair?.priceChange?.h24);
        if (Number.isFinite(change)) {
          els.change24.textContent = `${change >= 0 ? "+" : ""}${change.toFixed(2)}%`;
          els.change24.classList.toggle("positive", change >= 0);
          els.change24.classList.toggle("negative", change < 0);
        } else {
          els.change24.textContent = "—";
        }

        const buys = Number(pair?.txns?.h24?.buys);
        const sells = Number(pair?.txns?.h24?.sells);
        els.tx24.textContent =
          Number.isFinite(buys) && Number.isFinite(sells)
            ? `BUYS ${buys.toLocaleString()} / SELLS ${sells.toLocaleString()}`
            : "BUYS / SELLS —";

        els.liveStatus.textContent = "LIVE · DEXSCREENER";
      } catch (error) {
        console.warn(error);
        els.liveStatus.textContent = "MARKET DATA OFFLINE";
      }
    }

    document.querySelectorAll("[data-copy-ca]").forEach(button => {
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(TOKEN_ADDRESS);
          const toast = document.getElementById("toast");
          toast.classList.add("show");
          button.textContent = "COPIED";
          setTimeout(() => {
            toast.classList.remove("show");
            button.textContent = "COPY";
          }, 1600);
        } catch {
          window.prompt("Copy contract address:", TOKEN_ADDRESS);
        }
      });
    });

    const videos = [...document.querySelectorAll(".sticker video")];

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          const video = entry.target;
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      }, { rootMargin: "160px 0px", threshold: 0.02 });

      videos.forEach(video => observer.observe(video));
    }

    loadMarket();
    setInterval(loadMarket, 30000);
  </script>
</body>
</html>
